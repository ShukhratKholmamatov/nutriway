# ---------------------------------------------------------------
# Telegram lead notifications
# ---------------------------------------------------------------
# 1. Open @BotFather in Telegram → /newbot → copy the token here.
# 2. Add the bot to your group and make it an administrator.
# 3. Get the group id: add @RawDataBot to the group, or call
#    https://api.telegram.org/bot<TOKEN>/getUpdates after posting a
#    message in the group. Group ids start with -100.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_CHAT_ID=-1001234567890

# Optional — only if the group uses topics (forum mode) and leads
# should land in one specific topic.
# TELEGRAM_THREAD_ID=12

# ---------------------------------------------------------------
# Public site URL — used for canonical links, sitemap and JSON-LD.
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://nutriway.uz
